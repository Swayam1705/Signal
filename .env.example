# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
DATA_DIR=./data

# Speech-to-text (server only; never prefix with VITE_)
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
STT_MODEL=scribe_v1
STT_TIMEOUT_S=30
STT_MAX_RETRIES=1
MAX_AUDIO_BYTES=10485760

# Generation. 'extractive' is a labelled development fallback, not an LLM.
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=12
LLM_MAX_TOKENS=700

# Embeddings: hashing | sentence_transformers | openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Persistent embedded Qdrant
QDRANT_PATH=./data/index/qdrant
QDRANT_COLLECTION=signal_chunks

# Retrieval / reranking / grounding
TOP_K_CANDIDATES=12
RERANK_TOP_K=4
SEMANTIC_WEIGHT=0.55
LEXICAL_WEIGHT=0.35
METADATA_WEIGHT=0.10
MIN_RETRIEVAL_SCORE=0.20
MIN_QUERY_COVERAGE=0.30
GROUNDING_THRESHOLD=0.55
CONTEXT_TOKEN_BUDGET=900
MAX_RETRIES=1

# Offline chunking
CHUNK_SIZE=160
CHUNK_OVERLAP=32
MIN_CHUNK_SIZE=24
MAX_CHUNK_SIZE=240

# Optional for official dataset download
HF_TOKEN=
